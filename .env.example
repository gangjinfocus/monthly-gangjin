# Copy to .env on the server. Never commit .env, the database, or private backups.
NODE_ENV=development
HOST=127.0.0.1
PORT=4173
# Exact public origin, without trailing path. Production requires HTTPS.
APP_ORIGIN=http://localhost:4173
# Empty at domain root; e.g. /monthly-gangjin behind a subpath proxy.
BASE_PATH=
# Optional public API URL for a frontend using another host.
PUBLIC_API_BASE=
# Exact comma-separated HTTPS frontend origins allowed for public inquiry/content
# CORS only. Never use *; administrator endpoints remain strictly same-origin.
PUBLIC_ORIGINS=
# Persistent private directory outside any public document root.
DATA_DIR=.runtime
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0
# Account identity, not a website domain. Set password temporarily for init-admin,
# or supply it over piped stdin; do not store a plaintext password in this file.
ADMIN_EMAIL=gjfnews365@gmail.com
# Optional HTTPS endpoint that actually delivers mail. Payload contains private
# inquiry data. Configure only a trusted endpoint; failures remain visible in admin.
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
NOTIFICATION_EMAIL=gjfnews365@gmail.com
